rules_version = '2';

// Reglas de seguridad de Cloud Firestore (RNF01).
// Cada usuario solo lee y modifica lo que le corresponde según su rol.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esRol(rol) {
      return autenticado() && perfil().rol == rol;
    }

    function esEmpresaAprobada() {
      return esRol('empresa') && perfil().estadoValidacion == 'aprobada';
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------- Usuarios ----------
    match /usuarios/{uid} {
      // Cada usuario lee solo su perfil; el administrador lee todos (para validar empresas).
      allow read: if autenticado() && (request.auth.uid == uid || esRol('admin'));

      // Registro público: solo estudiante o empresa; la empresa nace "pendiente".
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.rol in ['estudiante', 'empresa']
        && (request.resource.data.rol == 'estudiante'
            || request.resource.data.estadoValidacion == 'pendiente');

      // El usuario edita sus datos, pero no puede cambiar su rol ni su validación.
      allow update: if request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['rol', 'estadoValidacion', 'motivoRechazo']);

      // El administrador aprueba o rechaza empresas (RF09).
      allow update: if esRol('admin')
        && resource.data.rol == 'empresa'
        && soloCambia(['estadoValidacion', 'motivoRechazo']);

      allow delete: if false;
    }

    // ---------- Ofertas ----------
    match /ofertas/{ofertaId} {
      // Las abiertas son públicas; la empresa ve también las suyas cerradas.
      // El estudiante que postuló puede seguir viendo la oferta aunque se cierre.
      allow read: if resource.data.estado == 'abierta'
        || (autenticado() && resource.data.empresaId == request.auth.uid)
        || esRol('admin')
        || (autenticado() && exists(/databases/$(database)/documents/postulaciones/$(ofertaId + '_' + request.auth.uid)));

      // RF02: solo una empresa aprobada publica, a su nombre y en estado "abierta".
      allow create: if esEmpresaAprobada()
        && request.resource.data.empresaId == request.auth.uid
        && request.resource.data.estado == 'abierta';

      // RF03: la empresa (aprobada) edita o cierra solo sus propias ofertas.
      allow update: if esEmpresaAprobada()
        && resource.data.empresaId == request.auth.uid
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.estado in ['abierta', 'cerrada'];

      // RF09: al rechazar una empresa, el administrador cierra sus ofertas.
      allow update: if esRol('admin')
        && soloCambia(['estado', 'actualizadaEn'])
        && request.resource.data.estado == 'cerrada';

      allow delete: if false;
    }

    // ---------- Postulaciones ----------
    // El id es "{ofertaId}_{estudianteId}": así un estudiante no puede postular dos veces.
    match /postulaciones/{postId} {
      allow read: if autenticado() && (
        postId.matches('.*_' + request.auth.uid)
        || resource.data.estudianteId == request.auth.uid
        || resource.data.empresaId == request.auth.uid
        || esRol('admin'));

      // RF06: el estudiante postula a una oferta abierta, con estado inicial "Enviada".
      allow create: if esRol('estudiante')
        && postId == request.resource.data.ofertaId + '_' + request.auth.uid
        && request.resource.data.estudianteId == request.auth.uid
        && request.resource.data.estado == 'Enviada'
        && get(/databases/$(database)/documents/ofertas/$(request.resource.data.ofertaId)).data.estado == 'abierta'
        && request.resource.data.empresaId == get(/databases/$(database)/documents/ofertas/$(request.resource.data.ofertaId)).data.empresaId;

      // RF07: la empresa dueña de la oferta cambia el estado.
      allow update: if autenticado()
        && resource.data.empresaId == request.auth.uid
        && soloCambia(['estado', 'historial', 'actualizadoEn'])
        && request.resource.data.estado in ['Enviada', 'Vista', 'Entrevista', 'Aceptada', 'Rechazada'];

      allow delete: if false;
    }

    // ---------- CV de las postulaciones ----------
    // El PDF se guarda como texto base64 (plan Spark sin Storage). Mismo id que la postulación.
    match /cvs/{postId} {
      allow read: if autenticado() && (
        resource.data.estudianteId == request.auth.uid
        || resource.data.empresaId == request.auth.uid
        || esRol('admin'));

      allow create: if esRol('estudiante')
        && postId == request.resource.data.ofertaId + '_' + request.auth.uid
        && request.resource.data.estudianteId == request.auth.uid
        && request.resource.data.empresaId == get(/databases/$(database)/documents/ofertas/$(request.resource.data.ofertaId)).data.empresaId
        && request.resource.data.contenido is string
        && request.resource.data.contenido.size() < 1000000;

      allow update, delete: if false;
    }
  }
}
